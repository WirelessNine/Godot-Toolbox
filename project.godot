; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Godot Toolbox"
run/main_scene="uid://cybuxqt0owxwf"
config/features=PackedStringArray("4.8", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

MenuManager="*res://addons/ui_expansion/singletons/menu_manager.gd"

[debug]

gdscript/warnings/directory_rules={
"res://addons/GDQuest_GDScript_formatter": 0,
"res://addons/kanban_tasks": 0
}
gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/mode=2

[editor_plugins]

enabled=PackedStringArray("res://addons/GDQuest_GDScript_formatter/plugin.cfg", "res://addons/kanban_tasks/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "yellow",
"res://test/": "gray"
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"

[wireless_nine]

presets_folder_path="res://presets"
